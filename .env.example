# Скопируйте в .env и поправьте под себя. Файл машинно-локальный и в git не идёт.
#     cp .env.example .env

# ── Где лежит сессия банка ───────────────────────────────────────────────────
# Каталог общий для демона входа и для того, кто запускает MCP. Выберите один
# вариант, иначе вход положит сессию туда, куда MCP не смотрит.
#
#   MCP на хосте (Claude Desktop, Claude Code) — путь, который MCP читает
#   по умолчанию. Подставьте свой домашний каталог:
# TBANK_SESSION_DIR=/Users/ваше-имя/.local/share/tbank-mcp
#
#   Всё в контейнерах (профиль mcp-http) — можно оставить в репозитории.
#   Каталог создайте заранее, иначе Docker сделает его от root:
#       mkdir -p data/session && chown $(id -u):$(id -g) data/session
TBANK_SESSION_DIR=./data/session

# ── Права на файл сессии ─────────────────────────────────────────────────────
# Сессия пишется с правами 0600, читать её должен процесс MCP. На Linux это
# значит, что uid внутри контейнера обязан совпасть с вашим:
#       id -u   и   id -g
# На macOS с Docker Desktop владелец подставляется сам, и это можно не трогать.
TBANK_UID=1000
TBANK_GID=1000

# ── Прочее ───────────────────────────────────────────────────────────────────
# Часовой пояс важен: окна лимитов календарные, сутки обнуляются в полночь.
TZ=Europe/Moscow

# Источники, которым демон входа разрешает CORS. Меняете порт вебморды —
# добавьте её адрес сюда, иначе браузер завернёт запрос на preflight.
TBANK_AUTHD_ORIGINS=http://127.0.0.1:8080,http://localhost:8080

# Имя агента для профиля mcp-http: по нему пишутся правила в фаерволе.
TBANK_AGENT_NAME=mcp-http
